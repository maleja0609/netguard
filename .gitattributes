# Normalizar saltos de línea a LF
* text=auto eol=lf

# Archivos binarios (no normalizar)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary

# Package files (evitar que se modifiquen por diferencias de npm)
package.json text eol=lf
package-lock.json text eol=lf -diff
*.lock text eol=lf -diff

# Python
*.py text eol=lf

# JavaScript/TypeScript
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# JSON
*.json text eol=lf

# Markdown
*.md text eol=lf